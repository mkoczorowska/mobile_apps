<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:background="@color/Cornsilk">

    <View
        android:id="@+id/prostokat"
        android:layout_width="300dp"
        android:layout_height="100dp"
        android:background="@color/white"
        android:layout_gravity="center"
        android:layout_margin="20dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dobierz kolor suwakami i przyciskiem"
        android:textSize="16sp"
        android:layout_margin="20dp"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R"
            android:textSize="16sp"/>
        <SeekBar
            android:id="@+id/r"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="255"
            android:progress="255"
            android:layout_marginHorizontal="20dp"/>
        <TextView
            android:id="@+id/r_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="255"
            android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G"
            android:textSize="16sp"/>
        <SeekBar
            android:id="@+id/g"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="255"
            android:progress="255"
            android:layout_marginHorizontal="20dp"/>
        <TextView
            android:id="@+id/g_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="255"
            android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B"
            android:textSize="16sp"/>
        <SeekBar
            android:id="@+id/b"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="255"
            android:progress="255"
            android:layout_marginHorizontal="20dp"/>
        <TextView
            android:id="@+id/b_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="255"
            android:textSize="16sp"/>
    </LinearLayout>
    <Button
        android:id="@+id/przycisk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pobierz"
        android:textSize="16sp"
        android:layout_gravity="center"
        android:layout_margin="20dp"/>

    <TextView
        android:id="@+id/wynik"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:text="255, 255, 255"
        android:layout_gravity="center"
        android:padding="10dp"/>

</LinearLayout>