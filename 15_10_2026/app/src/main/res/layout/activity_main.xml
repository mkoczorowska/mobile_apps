<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity"
    android:paddingTop="20dp">

    <TextView
        android:id="@+id/tytul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Domek w górach!"
        android:textSize="32sp"/>

    <ImageView
        android:id="@+id/obraz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/obraz"/>

    <LinearLayout
        android:id="@+id/przyciski"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/Teal">

        <Button
            android:id="@+id/polub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POLUB"
            android:textSize="16sp"
            android:backgroundTint="@color/Teal"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/usun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USUŃ"
            android:textSize="16sp"
            android:backgroundTint="@color/Teal"
            android:textColor="@color/white"/>


        <Button
            android:id="@+id/zapisz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZAPISZ"
            android:textSize="16sp"
            android:backgroundTint="@color/Teal"
            android:textColor="@color/white"/>
    </LinearLayout>

    <TextView
        android:id="@+id/liczba_polubien"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 polubień"
        android:textSize="15sp"
        android:textColor="@color/Gray"
        android:gravity="right"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/Gray"
        />

    <TextView
        android:id="@+id/opis_tytul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Opis"
        android:textColor="@color/Gray"
        android:textStyle="bold"
        android:textSize="24sp"/>

    <TextView
        android:id="@+id/opis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Odwiedź komfortowy domek w Sudetach, blisko do szlaków turystycznych"
        android:textColor="@color/Gray"
        android:textSize="24sp"/>

</LinearLayout>