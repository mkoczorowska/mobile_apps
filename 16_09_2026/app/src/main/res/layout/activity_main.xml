<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/LightBlue">
    
    <TextView
        android:id="@+id/header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:text="Urządzenia Domowe"
        android:textSize="20sp"
        android:gravity="center"
        />

    <TextView
        android:id="@+id/header_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:text="Autor: 000000mania"
        android:textSize="13sp"
        android:gravity="center"
        />

    <LinearLayout
        android:id="@+id/layout_pralka"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_pralka"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/pralka"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:id="@+id/layout2_pralka"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_pralka"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pralka"
                android:textSize="20sp"
                />

            <EditText
                android:id="@+id/edit_text_pralka"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/SkyBlue"
                android:hint="Podaj nr prania 1..12"
                android:textColorHint="@color/NavyBlue"
                android:textSize="13sp"
                android:inputType="number"/>

            <Button
                android:id="@+id/button_pralka"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="Zatwierdź"
                android:textSize="16sp"
                android:backgroundTint="@color/RoyalBlue"
                />

            <TextView
                android:id="@+id/nr_prania"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Numer prania: "
                android:textSize="13sp"
                />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_odkurzacz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_odkurzacz"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/odkurzacz"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:id="@+id/layout2_odkurzacz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_odkurzacz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Odkurzacz"
                android:textSize="20sp"
                />

            <Button
                android:id="@+id/button_odkurzacz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="Włącz"
                android:textSize="16sp"
                android:backgroundTint="@color/RoyalBlue"
                />

            <TextView
                android:id="@+id/status_odkurzacz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Odkurzacz wyłączony"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: naładowany"
                android:textSize="13sp"
                />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>